{
  "name": "CTYunPCKeepAliveElectron",
  "version": "1.3.0",
  "description": "天翼云电脑续命工具",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "start": "electron-vite preview --ignoreConfigWarning",
    "dev": "electron-vite dev --ignoreConfigWarning",
    "postinstall": "node node_modules/electron/install.js",
    "build": "npm run typecheck && electron-vite build --ignoreConfigWarning",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^26.1.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0-beta.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
